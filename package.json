{
  "name": "cc-vrf",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm test:ecvrf && pnpm test:client && pnpm test:demo",
    "test:ecvrf": "pnpm --filter @collectorcrypt/ecvrf test",
    "test:client": "pnpm --filter @collectorcrypt/vrf-client test",
    "test:demo": "pnpm --filter @collectorcrypt/dice-demo test",
    "lint": "prettier \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --check",
    "lint:fix": "prettier \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" -w"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
