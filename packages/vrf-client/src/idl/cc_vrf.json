    {
      "name": "VrfAuthority",
      "docs": [
        "Per-operator authority. Locks a published VRF public key on-chain so the",
        "operator cannot silently rotate to a different secret key. The",
        "`frozen` flag is one-way: once set, the pk and suite are permanent.",
        "`revoked` stays in the layout but nothing can set it: v2 removed",
        "`revoke_authority`. Commits still refuse an authority marked revoked.",
        "",
        "Stored as a Light compressed PDA. Seeds:",
        "[\"vrf_authority\", owner_pubkey, label_bytes]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "pk",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "suite",
            "type": "u8"
          },
          {
            "name": "frozen",
            "type": "bool"
          },
          {
            "name": "revoked",
            "type": "bool"
          },
          {
            "name": "label",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "created_slot",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "VrfBatchCommitted",
      "docs": [
        "One Merkle root over `count` VRF results (batch spec v1), from `commit_batch_event` (`ring_seq: None`) or",
        "`commit_batch_ring` (`ring_seq: Some(seq)`). Verify a leaf with `count`; see crates/cc-vrf-verify."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "label",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "root",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "count",
            "type": "u32"
          },
          {
            "name": "leaf_version",
            "type": "u8"
          },
          {
            "name": "ring_seq",
            "type": {
              "option": "u64"
            }
          },
          {
            "name": "committed_slot",
            "type": "u64"
          }
        ]
      }
    },
